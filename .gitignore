# Build output: `scripts/build_static.py` republishes app/static/ for the CDN and
# regenerates the manifest on every deploy.
public/
app/static_manifest.json

# Vercel CLI: linked-project settings and the env vars it pulls. `.env.example` is
# tracked on purpose, so this is deliberately not `.env*`.
.vercel/
.env.local

# Generated by `vercel build` from requirements.txt on every build. Not committed, so
# requirements.txt stays the single source of truth — a stale lock here silently
# reinstalled the dependencies it was generated from.
uv.lock
pyproject.toml
# The uv binary `vercel build` downloads into the project (54 MB).
_uv/
.env*
vercel-secrets.local.txt
_vercel_env.sh
.env.production.local

# Agent skills dropped in by the Neon marketplace integration. Tooling config, not
# part of the app.
.agents/
skills-lock.json
