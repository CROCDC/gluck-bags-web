# Bakes the promtail config into the image so no host bind-mount is needed.
# Jenkins runs the compose against the host daemon, but its workspace lives in a
# named volume (jenkins-data), so `./promtail.yml` can't be resolved as a host
# path — Docker would create an empty dir and the bind-mount fails. Baking the
# config avoids that entirely.
FROM grafana/promtail:latest
COPY promtail.yml /etc/promtail/config.yml
