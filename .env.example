FLASK_APP=run.py
FLASK_DEBUG=1
PORT=7014

# Persistent data dir (SQLite DB + uploaded media). Local dev defaults to
# ./instance; in Docker it is /data (a mounted volume).
DATA_DIR=instance

# Admin panel: the single shared password used to log in at /admin.
# Set a long, private value in production (injected via Infisical).
ADMIN_PASSWORD=changeme

# Flask session secret. If empty, a stable key is generated under DATA_DIR.
SECRET_KEY=
