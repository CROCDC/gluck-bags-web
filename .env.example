FLASK_APP=run.py
FLASK_DEBUG=1
PORT=7014

# Persistent data dir (SQLite DB + uploaded media). Local dev defaults to
# ./instance; in Docker it is /data (a mounted volume).
DATA_DIR=instance

# Admin panel: the single shared password used to log in at /admin.
# Set a long, private value in production (injected via Infisical).
ADMIN_PASSWORD=changeme

# Flask session secret. If empty, a stable key is generated under DATA_DIR.
SECRET_KEY=

# Set to 1 in production (HTTPS) to mark the session cookie Secure. Leave 0 for
# local http dev. SameSite=Lax + HttpOnly are always on.
SESSION_COOKIE_SECURE=0

# Public/canonical origin for OG, Twitter, canonical and sitemap URLs (no trailing
# slash). This is the single indexable domain — everything else 301s to it.
SITE_URL=https://gluckbags.com

# In production set to 1: the app 301-redirects every non-canonical host (www, the
# nexttech alias) and http -> SITE_URL, and adds HSTS. Leave 0 for local http dev.
FORCE_CANONICAL_HOST=0

# --- Tienda Nube (Nuvemshop) headless POC ------------------------------------
# See docs/TIENDANUBE-HEADLESS-POC.md. The API is OAuth server-to-server: after
# creating the Partner app and installing it in the store, the OAuth exchange
# yields a store id + a permanent access token. Put them here (private — inject via
# Infisical in prod). scripts/tn_spike.py reads these to validate the connection.
TN_STORE_ID=
TN_ACCESS_TOKEN=
# API version pinned in the base URL (https://api.tiendanube.com/<version>/<store>).
TN_API_VERSION=2025-03
# REQUIRED by Tienda Nube: an identifying User-Agent that includes a contact email.
TN_USER_AGENT=GLUCK Headless POC (dev@gluckbags.com)
